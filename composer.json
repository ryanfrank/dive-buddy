{
    "name": "divebuddy/dive-buddy",
    "description": "Dive Buddy - Connect divers worldwide for dive coordination, logging, and partner ratings.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "codeigniter4/framework": "^4.4",
        "league/oauth2-client": "^2.0",
        "onelogin/php-saml": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "codeigniter4/codeigniter4-standard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r "copy('.env.example', '.env');""
        ]
    }
}
