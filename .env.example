# Dive Buddy Environment Configuration
# Copy this file to .env and edit for your environment

CI_ENVIRONMENT = development

# Database (PostgreSQL)
database.default.hostname = localhost
database.default.database = dive_buddy
database.default.username = postgres
database.default.password = password
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432

# App
app.baseURL = 'http://localhost:8080/'
app.sessionCookieName = 'dive_buddy_session'

# Security
app.csrfProtection = true
app.cookieHTTPOnly = true
app.cookieSameSite = Lax

# OAuth (Google, Facebook, Apple, etc.)
oauth.google.client_id = YOUR_GOOGLE_CLIENT_ID
oauth.google.client_secret = YOUR_GOOGLE_CLIENT_SECRET
oauth.google.redirect_uri = http://localhost:8080/auth/oauth/google/callback

oauth.facebook.client_id = YOUR_FACEBOOK_CLIENT_ID
oauth.facebook.client_secret = YOUR_FACEBOOK_CLIENT_SECRET
oauth.facebook.redirect_uri = http://localhost:8080/auth/oauth/facebook/callback

oauth.apple.client_id = YOUR_APPLE_CLIENT_ID
oauth.apple.client_secret = YOUR_APPLE_CLIENT_SECRET
oauth.apple.redirect_uri = http://localhost:8080/auth/oauth/apple/callback

# SAML (optional)
saml.enabled = false
saml.idp.entity_id = ''
saml.idp.sso_url = ''
saml.idp.x509_cert = ''
saml.sp.entity_id = ''
saml.sp.private_key = ''
saml.sp.certificate = ''
